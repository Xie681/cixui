# Copy this file to .env and replace every change_me value.
# Do not commit real production secrets.

# MySQL
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password
MYSQL_DATABASE=cixiu
MYSQL_USER=cixiu
MYSQL_PASSWORD=change_me_mysql_app_password

# Redis
REDIS_PASSWORD=change_me_redis_password

# Spring profile
SPRING_PROFILES_ACTIVE=docker

# Frontend
# Leave empty for same-origin API calls through the frontend Nginx /api proxy.
VITE_API_BASE_URL=
FRONTEND_PORT=80

# File storage
FILE_STORAGE_TYPE=local
FILE_STORAGE_PUBLIC_URL=/uploads

# Elasticsearch JVM memory. Increase this only if the server has enough RAM.
ES_JAVA_OPTS=-Xms512m -Xmx512m

# Aliyun OSS. Leave these empty when FILE_STORAGE_TYPE=local.
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=

# DashScope / Qwen
DASHSCOPE_API_KEY=change_me_dashscope_api_key
